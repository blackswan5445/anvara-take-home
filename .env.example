# Database (port 5498 to avoid conflicts)
DATABASE_URL=postgresql://postgres:postgres@localhost:5498/anvara_sponsorships

# Backend (port 4291)
BACKEND_PORT=4291

# Frontend (port 3847) -> backend. Server-side only: the browser never calls the API directly.
API_URL=http://localhost:4291

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXX). Events log to the console in dev without it.
NEXT_PUBLIC_GA_ID=

# Better Auth
BETTER_AUTH_SECRET=use-openssl-rand-hex-32-to-generate-this
BETTER_AUTH_URL=http://localhost:3847
